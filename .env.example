# Supabase (recommended primary database)
# Add these in Vercel Project Settings -> Environment Variables
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback storage backend: Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional legacy aliases (also supported by server.js)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
